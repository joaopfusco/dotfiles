{
  "auto_install_extensions": {
    "ansible": true,
    "csharp": true,
    "docker": true,
    "dockerfile": true,
    "fish": true,
    "git-firefly": true,
    "html": true,
    "make": true,
    "material-icon-theme": true,
    "nix": true,
    "proto": true,
    "sql": true,
    "terraform": true,
    "toml": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "cli_default_open_behavior": "new_window",
  "file_finder": {
    "include_ignored": "all"
  },
  "file_types": {
    "Shell Script": [
      "envrc",
      ".envrc",
      "*.envrc"
    ]
  },
  "icon_theme": "Material Icon Theme",
  "languages": {
    "JSON": {
      "format_on_save": "off"
    },
    "JSONC": {
      "format_on_save": "off"
    },
    "Nix": {
      "language_servers": [
        "nixd",
        "!nil"
      ]
    },
    "Python": {
      "language_servers": [
        "pyright",
        "!ruff"
      ]
    }
  },
  "lsp": {
    "pyright": {
      "settings": {
        "python": {
          "analysis": {
            "typeCheckingMode": "basic"
          }
        }
      }
    }
  },
  "search": {
    "include_ignored": false
  },
  "soft_wrap": "editor_width",
  "theme": "One Dark",
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "shell": {
      "program": "fish"
    }
  }
}
